# Recordings stay local: audio is large and some sources (BBC) must not be
# redistributed. labels.json and README.md in recordings/ remain tracked.
recordings/*.wav
recordings/*.m4a
recordings/*.mp3
recordings/*.flac
recordings/*.ogg
recordings/*.aac

# FIGlet fonts stay local: the collection's licences are a patchwork and
# most files state none at all. fonts/README.md stays tracked and says where
# to get them.
fonts/*.flf
